# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/inventory_db

# ─── Security ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── OpenRouter / LangChain ───────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ─── SMTP ────────────────────────────────────────────────────────────────────
# For Gmail: generate an App Password at
#   Google Account → Security → 2-Step Verification → App passwords
# Never use your regular Gmail account password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
EMAIL_FROM=your-email@gmail.com

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=AI Smart Inventory System
FRONTEND_URL=http://localhost:5173
BACKEND_PORT=8000

# ─── Inventory Business Rules ─────────────────────────────────────────────────
SAFETY_BUFFER_DAYS=2
SAFETY_STOCK_DAYS=7
EXPIRY_WARNING_DAYS=30

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Cron: every day at 6:00 AM
SCHEDULER_CRON=0 6 * * *
